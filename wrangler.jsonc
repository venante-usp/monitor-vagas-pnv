{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor-vagas-pnv",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-22",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "PNV_MONITOR",
      "id": "c75823879b964fada328e5089d76325d"
    }
  ],

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
